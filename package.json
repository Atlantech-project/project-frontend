{
  "name": "atlantech-web-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "ATLANTECH web dashboard (Vue 3 + Vite)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
